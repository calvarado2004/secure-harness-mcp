# Copy to .env. The harness hardens the output of whatever model this points at —
# any OpenAI-compatible endpoint (local vLLM/llama.cpp/Ollama, or a hosted API).

# --- Model backend for the MCP tools (secure_generate / harden_code) ---
SECURE_HARNESS_MODEL_URL=http://localhost:8080/v1
SECURE_HARNESS_MODEL=your-model-id
SECURE_HARNESS_KEY=dummy

# --- Transparent proxy (secure_proxy.py) — front any model with the loop ---
SECURE_PROXY_UPSTREAM=http://localhost:8080/v1
SECURE_PROXY_KEY=dummy
SECURE_PROXY_MAX_ITERS=2

# Examples:
#   Ollama:     SECURE_HARNESS_MODEL_URL=http://localhost:11434/v1   SECURE_HARNESS_MODEL=qwen2.5-coder:32b
#   OpenAI:     SECURE_HARNESS_MODEL_URL=https://api.openai.com/v1   SECURE_HARNESS_KEY=sk-...   SECURE_HARNESS_MODEL=gpt-4o
#   local vLLM: SECURE_HARNESS_MODEL_URL=http://192.168.1.50:8000/v1 SECURE_HARNESS_MODEL=<served-id>
